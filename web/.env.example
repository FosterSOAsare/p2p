# API origin. Left unset, the client derives it from window.location.hostname
# (localhost -> localhost:8000, a LAN IP -> that IP:8000) so phone testing works
# with no config. See src/features/shared/libs/api.ts.
VITE_API_URL=http://localhost:8000

# Canonical origin for <link rel=canonical>, og:url and absolute og:image URLs.
# MUST be the real public origin in production — a wrong value here points every
# canonical tag at the wrong host, which is worse for SEO than having none.
# Keep it in step with the absolute URLs hardcoded in index.html and
# public/{robots.txt,sitemap.xml}.
VITE_SITE_URL=https://veritrust.app
