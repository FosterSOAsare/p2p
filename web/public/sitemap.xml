<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static routes only. Listings and seller profiles are database rows, so a
  complete sitemap has to be generated at build/deploy time against the API —
  see web/README.md. Until then those pages are discovered by crawling from
  /marketplace, which links to every one of them.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
